# ============================================================================
# Production environment variables (DO NOT commit real values — keep secrets
# in your hosting provider's secret store: Vercel / Railway / Neon dashboards).
# Copy to your provider's env vars. This file is documentation only.
# ============================================================================

# ---- Web (Vercel) ----
# Full base URL the browser uses to call the API, INCLUDING /api/v1.
# Replace with your deployed Railway API URL.
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api/v1

# ---- API (Railway) ----
NODE_ENV=production
# Railway/K8s set PORT dynamically; keep 3001 if running behind a proxy on 3001.
PORT=3001
# The Vercel site URL (so CORS allows the browser origin). No trailing slash.
CORS_ORIGIN=https://your-app.vercel.app
# MUST be a long random string in production (used to sign JWTs).
JWT_SECRET=replace-with-a-long-random-string

# ---- Postgres (Neon) ----
# Neon connection string. For serverless/Vercel-style clients use the
# pooled "-pooler" endpoint; the API runs long-lived connections so either works.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dataviz?sslmode=require

# ---- ClickHouse (OPTIONAL) ----
# Telemetry charts need ClickHouse. For v1 you can skip it (devices/datasets/
# dashboards still work; only the telemetry page will be empty). To enable,
# use ClickHouse Cloud's free tier and fill these in.
CLICKHOUSE_URL=https://your-instance.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-clickhouse-password
CLICKHOUSE_DB=industrial_analytics

# ---- Deploy-time DB setup (run once after Neon is connected) ----
# These are NOT runtime vars — run manually:
#   DATABASE_URL=<neon-url> npm run db:migrate
#   DATABASE_URL=<neon-url> npm run db:seed
