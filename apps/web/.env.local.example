# Copy this file to `.env.local` and adjust as needed.
# `.env.local` is git-ignored — never commit real secrets.

# Base URL of the API gateway / NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Show the "Generate Dev Token" (developer-only) button on the login page.
# Set to "true" ONLY for local development. It is OFF by default so that
# anonymous end users never see the dev-login shortcut.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
